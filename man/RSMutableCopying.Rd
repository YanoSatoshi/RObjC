  value = NULL,
  initialize = function(val) { self$value <- val },
  copyWithEnv = function(env) {
    obj <- MyClass$new(self$value)
    environment(obj) <- env
    obj
  }
))
MyClass$protocols <- c("RSCopying")
}

}
