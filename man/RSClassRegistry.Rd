}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{klass_name}}{A character string representing the name of the class to check.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
TRUE if the class is a standard robjc class; FALSE otherwise.
}
