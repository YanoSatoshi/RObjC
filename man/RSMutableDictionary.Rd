\item{\code{objects_and_keys}}{Alternating list of \code{list(key0, value0, key1, value1, ...)}.}

\item{\code{keys}}{List or vector of key objects.}

\item{\code{values}}{List or vector of value objects.}
}
\if{html}{\out{</div>}}
}
}
