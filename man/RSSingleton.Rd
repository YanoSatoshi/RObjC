  "LogManager",
  inherit = RSSingleton,
  public = list(
    initialize = function() {
      self$prefix <- RSString$stringWith("[LOG]")
      super$initialize()
    },
    log = function(msg) {
      cat(self$prefix$value(), msg, "\\\\n")
    }
  )
